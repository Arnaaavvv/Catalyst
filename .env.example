# Optional. Only needed for natural-language Quick Add parsing (server-side route).
# Without this, Quick Add falls back to a local heuristic parser automatically.
#
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. Defaults to "gemini-flash-latest" (an alias Google keeps
# pointed at their current fast model, so it won't go stale on you).
# GEMINI_MODEL=gemini-flash-latest
