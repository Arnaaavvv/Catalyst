# Required. Auth + data storage run on Supabase — see supabase/schema.sql for
# the one-time database setup, and README.md for the full walkthrough.
#
# Project Settings → API in your Supabase dashboard.
# NEXT_PUBLIC_ prefix is required by Next.js to expose these to the browser —
# this is expected and safe: the anon key is meant to be public, since Row
# Level Security (defined in supabase/schema.sql) is what actually enforces
# access control, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Only needed for natural-language Quick Add parsing (server-side route).
# Without this, Quick Add falls back to a local heuristic parser automatically.
#
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. Defaults to "gemini-flash-latest" (an alias Google keeps
# pointed at their current fast model, so it won't go stale on you).
# GEMINI_MODEL=gemini-flash-latest
